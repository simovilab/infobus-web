# Copy to .env and adjust. Read by Docker Compose (compose.yaml) and by Nuxt at runtime.

# --- Deployment ---------------------------------------------------------------
# Public hostname served by Traefik; its DNS record must point to the server.
DOMAIN=infobus.example.com

# Names of the entrypoints and certificate resolver configured in your Traefik instance.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERT_RESOLVER=letsencrypt

# Image built by `docker compose build`.
IMAGE_NAME=infobus-web
IMAGE_TAG=latest

# --- Nuxt ---------------------------------------------------------------------
# Public URL, used for OG images. Defaults to https://${DOMAIN} when deployed with compose.yaml.
NUXT_PUBLIC_SITE_URL=
