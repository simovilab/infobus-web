# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Static GTFS API base URL (bucr). Leave empty to use the default
# (raw.githubusercontent.com/simovilab/bucr/...), or point it at /api/ to
# force the local fallback copy in site/public/api/.
NUXT_PUBLIC_GTFS_API_BASE=
