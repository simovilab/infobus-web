{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infobus.example/schemas/architecture.schema.json",
  "title": "Infobús Web Information Architecture",
  "description": "Validates the page and component inventory for the Infobus website.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "metadata", "pages"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./architecture.schema.json"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "title", "date"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "description", "components"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+|<[a-z][a-z0-9_]*>)(?:/(?:[a-z0-9-]+|<[a-z][a-z0-9_]*>))*$|^/$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "type", "structure"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["editorial_content", "feed", "local_storage"],
          "description": "Source of the component's data: staff-written content, the Infobús API feed, or the visitor's browser storage."
        },
        "gtfs": {
          "type": "string",
          "enum": ["Schedule", "Realtime"],
          "description": "Highest GTFS layer the component depends on; realtime components may also read schedule data."
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "structure": {
          "$ref": "#/$defs/structure"
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "feed"
          }
        }
      },
      "then": {
        "required": ["gtfs", "endpoints"]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": ["gtfs"]
            },
            {
              "required": ["endpoints"]
            }
          ]
        }
      }
    },
    "dataEntity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
      "description": "A unit of information as <source>.<field>, e.g. a GTFS table column (routes.route_id), a GTFS-RT message field (trip_updates.delay), a derived API value (run.id, trip.last_stop_name), an editorial field (news.title) or a browser-stored value (recent_pages.path)."
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": ["object", "array"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/dataEntity"
              },
              {
                "$ref": "#/$defs/structure"
              }
            ]
          }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "format", "path"],
      "properties": {
        "protocol": {
          "type": "string",
          "enum": ["HTTP", "WebSocket"]
        },
        "format": {
          "type": "string",
          "enum": ["JSON", "GeoJSON"]
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9_-]+|<[a-z][a-z0-9_]*>)(?:/(?:[a-z0-9_-]+|<[a-z][a-z0-9_]*>))*$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
          "description": "The JSON key used to locate the data in the endpoint."
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.(?:[a-z][a-z0-9_]*|<[a-z][a-z0-9_]*>))*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "WebSocket"
              }
            }
          },
          "then": {
            "required": ["topic"]
          },
          "else": {
            "not": {
              "required": ["topic"]
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "protocol": {
                    "const": "HTTP"
                  }
                }
              },
              {
                "properties": {
                  "format": {
                    "const": "JSON"
                  }
                }
              }
            ]
          },
          "then": {
            "required": ["key"]
          },
          "else": {
            "not": {
              "required": ["key"]
            }
          }
        }
      ]
    }
  }
}
